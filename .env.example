# ─── CODEVERSE Website — Environment Variables ───────────────────────────────
# Copy this file to .env.local and populate values before running locally.
# Never commit .env.local to version control.

# ─── Site ────────────────────────────────────────────────────────────────────
# Production URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://codeverse.digital

# ─── Contact ─────────────────────────────────────────────────────────────────
# Public business email shown on the website
NEXT_PUBLIC_CONTACT_EMAIL=hello@codeverse.digital

# WhatsApp number in E.164 format (e.g. 8801XXXXXXXXX) — no + prefix
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Social Links ─────────────────────────────────────────────────────────────
# Leave blank to hide a social link
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ─── Email Delivery (server-side only) ───────────────────────────────────────
# Option A: Resend (https://resend.com)
RESEND_API_KEY=

# Option B: SMTP (e.g. AWS SES, SendGrid, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Recipient inbox for project enquiries
CONTACT_RECIPIENT_EMAIL=

# Verified sender email address (e.g. enquiries@codeverse.digital or onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=CODEVERSE Enquiries <onboarding@resend.dev>

# ─── Security & Reverse Proxy ─────────────────────────────────────────────────
# Set to 'vercel', 'cloudflare', 'nginx', or leave blank for auto-fallback.
# When set, rate limiting strictly relies on the authenticated proxy header
# and ignores spoofed client-supplied proxy headers from untrusted networks.
TRUSTED_PROXY_PROVIDER=
